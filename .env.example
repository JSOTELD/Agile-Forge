# ==============================================================================
# AgileForge v2 - Environment configuration (.env)
# AgileForge v2 - Configuración de entorno (.env)
# ==============================================================================
# EN: Copy this file to `.env` in the project root before starting:
#       cp .env.example .env
#     or run the first-time migration, which creates it for you (non-destructive):
#       php bin/migrate.php
# ES: Copia este archivo a `.env` en la raíz del proyecto antes de iniciar:
#       cp .env.example .env
#     o ejecuta la migración inicial, que lo crea por ti (no destructiva):
#       php bin/migrate.php
# No real values live in this file. / Este archivo no contiene valores reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# Access tokens / Tokens de acceso
# ------------------------------------------------------------------------------
# EN: Main API token (full access: MCP, CLI, web UI). Leave it empty: the app
#     generates a secure random one on first run. Never commit or share it.
# ES: Token principal de la API (acceso total: MCP, CLI, interfaz web). Déjalo
#     vacío: la app genera uno aleatorio y seguro en el primer arranque. Nunca
#     lo subas a Git ni lo compartas.
AGILEFORGE_API_TOKEN=

# EN: Read-only token. It only works for GET on api/index.php and only on these
#     routes: overview, events, meetings, meetings/{id}, decisions, tasks,
#     tasks/{id}, sprint/status and roles/{id}/brief. Everything else (/state,
#     /skills, /roles, writes, api/tasks.php) answers 403. It is the token used by
#     the read-only page (vista.php) and the AgileForge Vista plugin. Generated
#     automatically if empty.
# ES: Token de solo lectura. Solo sirve para GET en api/index.php y únicamente en
#     estas rutas: overview, events, meetings, meetings/{id}, decisions, tasks,
#     tasks/{id}, sprint/status y roles/{id}/brief. Todo lo demás (/state,
#     /skills, /roles, escrituras, api/tasks.php) responde 403. Es el token que
#     usan la página de solo lectura (vista.php) y el plugin AgileForge Vista. Se
#     genera solo si está vacío.
AGILEFORGE_VIEW_TOKEN=

# ------------------------------------------------------------------------------
# Storage and environment / Almacenamiento y entorno
# ------------------------------------------------------------------------------
# EN: SQLite database path, relative to the project root or absolute.
# ES: Ruta de la base de datos SQLite, relativa a la raíz del proyecto o absoluta.
AGILEFORGE_DB_PATH=data/agileforge.sqlite

# EN: Runtime environment: local | production | test
# ES: Entorno de ejecución: local | production | test
AGILEFORGE_ENV=local

# ------------------------------------------------------------------------------
# MCP / Claude Code plugin (optional) / Plugin MCP de Claude Code (opcional)
# ------------------------------------------------------------------------------
# EN: The plugin brain is Claude Code itself: AgileForge works with no API keys and
#     no local AI. The MCP server finds the API URL and token on its own (these
#     variables, this file, or ~/.agileforge/config.json). Set the URL only if
#     the app is not at the default http://localhost/Open-to-code/api
# ES: El cerebro del plugin es el propio Claude Code: AgileForge funciona sin
#     claves de API ni IA local. El servidor MCP encuentra solo la URL y el token
#     (estas variables, este archivo o ~/.agileforge/config.json). Define la URL
#     solo si la app no está en el valor por defecto http://localhost/Open-to-code/api
# AGILEFORGE_API_URL=

# EN: Web-engine tools for the MCP (`director_instruction`, `ask_agent`). They are
#     registered ONLY when this is `on`; it is read by the MCP server, not by PHP.
#     Needs an LLM provider key (below) or local AI.
# ES: Herramientas del motor web para el MCP (`director_instruction`, `ask_agent`).
#     Solo se registran si vale `on`; lo lee el servidor MCP, no PHP. Requiere una
#     clave de proveedor LLM (abajo) o IA local.
# AGILEFORGE_ENGINE_TOOLS=off

# ------------------------------------------------------------------------------
# LLM providers, server-side API mode (optional) / Proveedores LLM, modo API en el servidor (opcional)
# ------------------------------------------------------------------------------
# EN: You can paste them from the UI: AI Engine -> API keys (they are saved here).
#     Each role uses the provider/model assigned in "Agent Team". Keys are NEVER
#     sent to the browser and are never committed to Git.
# ES: Puedes pegarlas desde la interfaz: Motor IA -> Claves de API (se guardan aquí).
#     Cada rol usa el proveedor/modelo que le asignes en "Equipo de Agentes". Las
#     claves NUNCA se envían al navegador ni se versionan en Git.

# EN: Anthropic - Claude Opus 5.5, Sonnet 5.5, Haiku 5.5 (recommended for the Director)
# ES: Anthropic - Claude Opus 5.5, Sonnet 5.5, Haiku 5.5 (recomendado para el Director)
# ANTHROPIC_API_KEY=

# EN: Optional Anthropic workspace ID (not a secret): only if your key is not tied to a workspace.
# ES: ID de workspace de Anthropic, opcional (no es un secreto): solo si tu clave no está asociada a un workspace.
# ANTHROPIC_WORKSPACE_ID=

# EN: OpenAI - GPT-6.1 (Sol, Terra) and GPT-6 (Astra, Luna)
# ES: OpenAI - GPT-6.1 (Sol, Terra) y GPT-6 (Astra, Luna)
# OPENAI_API_KEY=

# EN: Google Gemini - Gemini 3 Flash and Gemini 3.1 Pro
# ES: Google Gemini - Gemini 3 Flash y Gemini 3.1 Pro
# GEMINI_API_KEY=

# EN: DeepSeek - DeepSeek V4 (Flash, Pro)
# ES: DeepSeek - DeepSeek V4 (Flash, Pro)
# DEEPSEEK_API_KEY=

# EN: Local Ollama (open-source models running on your machine)
# ES: Ollama local (modelos de código abierto en tu máquina)
# OLLAMA_HOST=http://localhost:11434
