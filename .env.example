# ==============================================================================
# AgileForge v2 - Configuración de Entorno (.env)
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto antes de iniciar:
# cp .env.example .env
# O ejecuta la migración inicial para autogenerarlo:
# php bin/migrate.php
# ==============================================================================

# Token de seguridad de la API local (Requerido para MCP y CLI)
# Puede ser cualquier cadena hexadecimal segura de 32 o 64 caracteres.
# Si está vacío al ejecutar `php bin/migrate.php`, se generará uno automáticamente.
AGILEFORGE_API_TOKEN=tu_token_secreto_hexadecimal_aqui

# Ruta relativa o absoluta a la base de datos SQLite
AGILEFORGE_DB_PATH=data/agileforge.sqlite

# Entorno de ejecución: local | production | test
AGILEFORGE_ENV=local

# ------------------------------------------------------------------------------
# Configuración Opcional de Proveedores de LLM (Modo API Server-Side)
# ------------------------------------------------------------------------------
# Solo requeridas si deseas utilizar salas de reuniones o chat en vivo usando
# llamadas directas a las APIs en lugar del modo plugin / CLI anfitrión.
# Las claves NUNCA se envían al navegador ni se versionan en Git.

# Anthropic (Claude 3.5 Sonnet, Claude 3.7 Sonnet, etc.)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT-4o, GPT-4o-mini, o1, etc.)
# OPENAI_API_KEY=sk-proj-...

# Google Gemini (Gemini 2.0 Flash, Gemini 1.5 Pro, etc.)
# GEMINI_API_KEY=AIzaSy...

# DeepSeek (DeepSeek-V3, DeepSeek-R1)
# DEEPSEEK_API_KEY=sk-...

# Ollama Local (Modelos open-source locales)
# OLLAMA_HOST=http://localhost:11434
