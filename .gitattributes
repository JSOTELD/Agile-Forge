# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Explicit text files
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.env.example text eol=lf
.htaccess text eol=lf

# PowerShell scripts need CRLF or LF on Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
