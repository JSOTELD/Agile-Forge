# ==========================================
# AgileForge v2 - Git Ignore Configuration
# ==========================================

# Variables de entorno y secretos
.env
.env.local
.env.*.local
*.env
!.env.example

# Base de datos SQLite y memoria temporal
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
*.sqlite
*.sqlite3
*.db

# Backups locales (mantener la estructura con .gitkeep)
data/backup/*
!data/backup/.gitkeep

# Node.js y dependencias
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos de prueba y scratch temporal
scratch/
test-*.json
*.tmp
*.temp

# Archivos de sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editores e IDEs locales
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~
