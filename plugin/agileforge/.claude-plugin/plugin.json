{
  "name": "agileforge",
  "displayName": "AgileForge Control",
  "version": "2.2.0",
  "description": "Equipo ágil de agentes que maneja el tablero AgileForge desde Claude Code. / Agile agent team that runs the AgileForge board from Claude Code.",
  "author": {
    "name": "JSOTELD",
    "url": "https://github.com/JSOTELD"
  },
  "homepage": "https://github.com/JSOTELD/agile-forge",
  "repository": "https://github.com/JSOTELD/agile-forge",
  "license": "MIT",
  "keywords": [
    "scrum",
    "agile",
    "multi-agent",
    "kanban",
    "mcp",
    "agileforge"
  ],
  "mcpServers": {
    "board": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/agileforge-mcp.mjs"
      ],
      "env": {
        "AGILEFORGE_MODE": "full",
        "AGILEFORGE_CLIENT": "claude-code",
        "AGILEFORGE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "AGILEFORGE_API_URL": "${AGILEFORGE_API_URL:-}",
        "AGILEFORGE_API_TOKEN": "${AGILEFORGE_API_TOKEN:-}",
        "AGILEFORGE_HOME": "${AGILEFORGE_HOME:-}",
        "AGILEFORGE_ENGINE_TOOLS": "${AGILEFORGE_ENGINE_TOOLS:-off}"
      }
    }
  }
}
