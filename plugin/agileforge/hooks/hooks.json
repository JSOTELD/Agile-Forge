{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/agileforge-mcp.mjs", "--session-brief"],
            "timeout": 10,
            "statusMessage": "AgileForge: leyendo el tablero"
          }
        ]
      }
    ]
  }
}
